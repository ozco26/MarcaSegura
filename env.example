# Copia este archivo como .env y completa los valores.

SECRET_KEY=cambia-esta-clave
JWT_SECRET_KEY=cambia-esta-otra-clave

DATABASE_URL=mysql+pymysql://usuario:clave@localhost/marcasegura

# True en producción (solo envía la cookie por HTTPS)
JWT_COOKIE_SECURE=False

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=tu-correo@ejemplo.com
MAIL_PASSWORD=tu-clave-de-aplicacion
MAIL_DEFAULT_SENDER=tu-correo@ejemplo.com
